#. Plugin Name of the plugin.
msgid "HTML → Markdown Site Export"
msgstr "HTML → Markdown: Експорт сайту"

#. Description of the plugin.
msgid "Crawls the WP sitemap and saves every rendered page as a Markdown file, including image links and SEO data from <head>."
msgstr "Обходить карту сайту WP і зберігає кожну зрендерену сторінку як файл Markdown, включно з посиланнями на зображення та SEO-даними з <head>."

#: includes/class-sitemap-crawler.php
msgid "Could not find sitemap. Please enter the URL manually in settings."
msgstr "Не вдалося знайти карту сайту. Введіть URL вручну в налаштуваннях."

#: includes/class-sitemap-crawler.php
msgid "Sitemap found but it contains no URLs."
msgstr "Карту сайту знайдено, але вона не містить жодного URL."

#: includes/class-page-fetcher.php
#, php-format
msgid "HTTP %d while fetching the page."
msgstr "HTTP %d під час завантаження сторінки."

#: includes/class-page-fetcher.php
#, php-format
msgid "Page is not HTML (%s)."
msgstr "Сторінка не є HTML (%s)."

#: includes/class-page-fetcher.php
msgid "Empty page response."
msgstr "Порожня відповідь сторінки."

#: includes/class-exporter.php
msgid "Attempted to write outside the export directory."
msgstr "Спроба запису за межами папки експорту."

#: includes/class-exporter.php
msgid "Could not create the export directory."
msgstr "Не вдалося створити папку експорту."

#: includes/class-exporter.php
msgid "Could not write file."
msgstr "Не вдалося записати файл."

#: includes/class-exporter.php
msgid "Site Map"
msgstr "Карта сайту"

#: includes/class-exporter.php
#, php-format
msgid "Generated %1$s — %2$d pages."
msgstr "Згенеровано %1$s — %2$d сторінок."

#: includes/class-plugin.php
msgid "Insufficient permissions."
msgstr "Недостатньо прав."

#: includes/class-plugin.php
msgid "Queue not found. Please build the sitemap first."
msgstr "Чергу не знайдено. Спочатку зберіть карту сайту."

#: includes/class-admin-page.php
msgid "HTML → Markdown"
msgstr "HTML → Markdown"

#: includes/class-admin-page.php
msgid "Building sitemap…"
msgstr "Збираю карту сайту…"

#: includes/class-admin-page.php
msgid "Pages found:"
msgstr "Знайдено сторінок:"

#: includes/class-admin-page.php
msgid "Exporting…"
msgstr "Експортую…"

#: includes/class-admin-page.php
msgid "Done! Pages exported:"
msgstr "Готово! Експортовано сторінок:"

#: includes/class-admin-page.php
msgid "Error:"
msgstr "Помилка:"

#: includes/class-admin-page.php
msgid "Settings"
msgstr "Налаштування"

#: includes/class-admin-page.php
msgid "Crawls the sitemap, fetches the rendered HTML of every page, and saves it as Markdown with SEO metadata and image links."
msgstr "Обходить карту сайту, завантажує зрендерований HTML кожної сторінки та зберігає його у форматі Markdown із SEO-метаданими та посиланнями на зображення."

#: includes/class-admin-page.php
msgid "Sitemap URL"
msgstr "URL карти сайту"

#: includes/class-admin-page.php
msgid "Leave blank to auto-detect (wp-sitemap.xml / sitemap_index.xml)."
msgstr "Залиште порожнім для автовизначення (wp-sitemap.xml / sitemap_index.xml)."

#: includes/class-admin-page.php
msgid "Export folder"
msgstr "Папка експорту"

#: includes/class-admin-page.php
msgid "Must be inside wp-content/uploads."
msgstr "Має бути всередині wp-content/uploads."

#: includes/class-admin-page.php
msgid "Batch size"
msgstr "Розмір батчу"

#: includes/class-admin-page.php
msgid "Pages per AJAX request (1–50)."
msgstr "Сторінок на один AJAX-запит (1–50)."

#: includes/class-admin-page.php
msgid "Content selector"
msgstr "Селектор контенту"

#: includes/class-admin-page.php
msgid "Default: body. Can be narrowed to: main, #content, .entry-content."
msgstr "За замовчуванням: body. Можна звузити: main, #content, .entry-content."

#: includes/class-admin-page.php
msgid "Base URL override"
msgstr "Перевизначення базового URL"

#: includes/class-admin-page.php
msgid "Leave blank if loopback works. Useful for non-standard local hostnames."
msgstr "Залиште порожнім, якщо loopback працює. Корисно для нестандартних локальних хостів."

#: includes/class-admin-page.php
msgid "Basic Auth (optional)"
msgstr "Basic Auth (необов'язково)"

#: includes/class-admin-page.php
msgid "username"
msgstr "логін"

#: includes/class-admin-page.php
msgid "password"
msgstr "пароль"

#: includes/class-admin-page.php
msgid "For password-protected staging environments."
msgstr "Для захищеного паролем staging-середовища."

#: includes/class-admin-page.php
msgid "Save Settings"
msgstr "Зберегти налаштування"

#: includes/class-admin-page.php
msgid "Export"
msgstr "Експорт"

#: includes/class-admin-page.php
msgid "1. Build sitemap"
msgstr "1. Зібрати карту сайту"

#: includes/class-admin-page.php
msgid "2. Export"
msgstr "2. Експортувати"
